            <trans-unit id="module.title"><source>PPL Rights Management</source></trans-unit>
            <trans-unit id="module.intro"><source>Central backend module for managing PPL groups, users, rights, modules and mounts.</source></trans-unit>
            <trans-unit id="tabs.overview.label"><source>Overview</source></trans-unit>
            <trans-unit id="tabs.overview.description"><source>Shows current and inherited rights, modules and mounts for selected groups or users.</source></trans-unit>
            <trans-unit id="tabs.groupManagement.label"><source>Group Management</source></trans-unit>
            <trans-unit id="tabs.groupManagement.description"><source>Manages the base configuration for backend groups.</source></trans-unit>
            <trans-unit id="tabs.groupRightsManagement.label"><source>Group Rights Management</source></trans-unit>
            <trans-unit id="tabs.groupRightsManagement.description"><source>Manages record and table permissions for backend groups.</source></trans-unit>
            <trans-unit id="tabs.moduleManagement.label"><source>Module Management</source></trans-unit>
            <trans-unit id="tabs.moduleManagement.description"><source>Manages backend module permissions for backend groups.</source></trans-unit>
            <trans-unit id="tabs.groupRightsInheritanceManagement.label"><source>Group Rights Inheritance</source></trans-unit>
            <trans-unit id="tabs.groupRightsInheritanceManagement.description"><source>Defines which backend groups inherit rights from other groups.</source></trans-unit>
            <trans-unit id="tabs.backendUserManagement.label"><source>Backend User Management</source></trans-unit>
            <trans-unit id="tabs.backendUserManagement.description"><source>Manages backend user specific settings.</source></trans-unit>
            <trans-unit id="tabs.mountManagement.label"><source>Mount Management</source></trans-unit>
            <trans-unit id="tabs.mountManagement.description"><source>Assigns DB and file mounts to backend groups.</source></trans-unit>
